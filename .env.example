# Copia este archivo a .env (local) o pega las variables en Vercel / Render.
# Ninguna es obligatoria: la API funciona sin claves ni configuración.

# Puerto del servidor Node. Render y Vercel lo gestionan automáticamente.
PORT=3000

# Si se define, TODOS los /api/* exigen ?apikey=..., X-API-Key o Bearer token.
# API_KEY=mi-clave-secreta

# Modelos de IA. Sin clave responden en "modo demo" local.
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODELO=gemini-2.0-flash

# Límite de peticiones por minuto y por IP (0 = sin límite).
LIMITE_POR_MINUTO=120

# Dominio público para las URLs absolutas dentro de las respuestas JSON.
# Si está vacío se detecta automáticamente desde las cabeceras.
URL_BASE=

# Dominio base que se usa en la documentación (opcional).
# MODO_OFFLINE=1      -> simula un despliegue sin internet (tests / CI)
# PERMITIR_PRIVADOS=1 -> permite fetch a hosts privados (solo desarrollo)
# PERMITIR_HOSTS=127.0.0.1,localhost
